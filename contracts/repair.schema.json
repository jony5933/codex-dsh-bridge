{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-deepseek-loop/repair.schema.json",
  "title": "Codex review repair overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "repair"],
  "properties": {
    "version": { "const": 1 },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentContract", "iteration", "findings"],
      "properties": {
        "parentContract": { "type": "string", "minLength": 1 },
        "iteration": { "type": "integer", "minimum": 1, "maximum": 2 },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "title", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "severity": { "enum": ["P0", "P1", "P2", "P3"] },
              "title": { "type": "string", "minLength": 3 },
              "description": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    }
  }
}
